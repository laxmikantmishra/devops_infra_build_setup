# Copy this file to sandbox.env and replace blank application-specific values.
# Copy to config/sandbox.env. Never put passwords or tokens in this file.
ENVIRONMENT=sandbox
TENANT_ID=
SUBSCRIPTION_ID=
LOCATION=eastus

# Application identifier and resource naming convention (EU is a naming token).
APPLICATION_NAME=askey-swarms-sandbox
RESOURCE_NAME_PREFIX=AEY-EU-SWARMS-SANDBOX
SHORT_RESOURCE_NAME_PREFIX=AEY-EU-SWARMS-SBX
RESOURCE_INSTANCE=01

# No custom app registration/service principal is required for interactive login.
# Modes: Interactive, DeviceCode, ExistingContext, ServicePrincipalCertificate,
# ManagedIdentity (only on a runner that has that identity assigned).
AUTH_MODE=Interactive
AUTH_CLIENT_ID=
AUTH_CERTIFICATE_THUMBPRINT=

# Bootstrap checks selected subscription; it never creates a subscription.
# Register only missing providers required by the selected resource plan.
BOOTSTRAP_REGISTER_PROVIDERS=true

# Deployment machine's public egress IPv4 as a single /32 (not its LAN IP).
# Mode: PublicAllowList or Private. Private requires reachable private endpoints.
DEPLOYMENT_NETWORK_MODE=PublicAllowList
DEPLOYMENT_CLIENT_IPV4=
# Lifetime: Temporary or Persistent. Temporary rules need recorded cleanup.
DEPLOYMENT_ACCESS_LIFETIME=Temporary
DEPLOYMENT_ALLOW_SQL=true
DEPLOYMENT_ALLOW_KEY_VAULT=true
DEPLOYMENT_ALLOW_APP_SERVICE_SCM=true
# Public app access for smoke tests is separate from SCM deployment access.
DEPLOYMENT_ALLOW_APP_SERVICE_MAIN=false

# Modes: Create, Existing, Auto. Existing requires an explicit resource ID.
RESOURCE_GROUP_MODE=Auto
RESOURCE_GROUP_NAME=AEY-EU-SWARMS-SANDBOX-RG-01
RESOURCE_GROUP_ID=

# Shared user-assigned runtime identity for App Service and the worker VM.
# Existing requires its full Azure resource ID. Client/principal IDs are discovered.
MANAGED_IDENTITY_MODE=Auto
MANAGED_IDENTITY_NAME=AEY-EU-SWARMS-SANDBOX-UAMI-01
MANAGED_IDENTITY_ID=

APP_SERVICE_PLAN_MODE=Auto
APP_SERVICE_PLAN_NAME=AEY-EU-SWARMS-SANDBOX-ASP-01
APP_SERVICE_PLAN_ID=
WEB_APP_MODE=Auto
WEB_APP_NAME=aey-eu-swarms-sandbox-app-01
WEB_APP_ID=
WEB_OS=
WEB_RUNTIME=

WORKER_VM_MODE=Auto
WORKER_VM_NAME=AEY-EU-SWARMS-SANDBOX-VM-01
WORKER_VM_ID=
# Guest hostname is distinct from the Azure VM resource name.
WORKER_COMPUTER_NAME=AEYEUSWRMSBX01
WORKER_OS=
WORKER_RUNTIME=

# SQL product must be confirmed before creation settings can be finalized.
SQL_PRODUCT=AzureSqlDatabase
SQL_SERVER_MODE=Auto
SQL_SERVER_NAME=aey-eu-swarms-sandbox-sql-01
SQL_SERVER_ID=
# Structured collections use JSON files, with paths relative to this env file.
DATABASES_FILE=databases.example.json

APPLICATION_INSIGHTS_MODE=Auto
APPLICATION_INSIGHTS_NAME=AEY-EU-SWARMS-SANDBOX-AI-01
APPLICATION_INSIGHTS_ID=
LOG_ANALYTICS_MODE=Auto
LOG_ANALYTICS_NAME=AEY-EU-SWARMS-SANDBOX-LAW-01
LOG_ANALYTICS_ID=
KEY_VAULT_MODE=Auto
KEY_VAULT_NAME=aey-eu-swarms-sbx-kv-01
KEY_VAULT_ID=
NETWORK_MODE=Auto
NETWORK_NAME=AEY-EU-SWARMS-SANDBOX-VNET-01
NETWORK_ID=

# Same-resource-group private staging used for VM worker packages.
DEPLOYMENT_STORAGE_MODE=Auto
DEPLOYMENT_STORAGE_NAME=aeyeuswarmssbxst01
DEPLOYMENT_STORAGE_ID=
DEPLOYMENT_STORAGE_SKU=Standard_LRS
DEPLOYMENT_STORAGE_CONTAINER=releases

VNET_ADDRESS_PREFIX=10.42.0.0/16
WORKER_SUBNET_NAME=snet-worker
WORKER_SUBNET_PREFIX=10.42.1.0/24
APP_SUBNET_NAME=snet-app
APP_SUBNET_PREFIX=10.42.2.0/24

LOG_ANALYTICS_RETENTION_DAYS=30
KEY_VAULT_ENABLE_RBAC=true
KEY_VAULT_SECRET_NAMES=
APP_SERVICE_PLAN_SKU=B1
APP_SERVICE_PLAN_WORKER_COUNT=1
WEB_HEALTH_PATH=/
WEB_USE_STAGING_SLOT=false
WEB_APP_SETTINGS_FILE=
WORKER_VM_SIZE=Standard_B2s
WORKER_ADMIN_USERNAME=azureuser
WORKER_SSH_PUBLIC_KEY_PATH=
WORKER_IMAGE_PUBLISHER=
WORKER_IMAGE_OFFER=
WORKER_IMAGE_SKU=
WORKER_IMAGE_VERSION=latest
WORKER_SERVICE_NAME=SwarmsWorker
WORKER_EXECUTABLE=
WORKER_ARGUMENTS=
WORKER_HEALTH_COMMAND=
# Sql uses credentials supplied to the scripts; no passwords belong in this file.
SQL_AUTHENTICATION_MODE=Sql
# Optional Entra mode only; ignored in Sql mode.
SQL_ENTRA_ADMIN_DISPLAY_NAME=
SQL_ENTRA_ADMIN_OBJECT_ID=
SQL_DATABASE_DEFAULT_EDITION=GeneralPurpose
SQL_DATABASE_DEFAULT_SERVICE_OBJECTIVE=GP_S_Gen5_1
SQL_RUNTIME_ROLES=db_datareader,db_datawriter

# Set WEB_OS, WEB_RUNTIME, WORKER_OS, the Linux SSH key (or supply a Windows
# credential) before provisioning. Supply -SqlAdministratorCredential securely. WORKER_EXECUTABLE
# is required later only when Deployment targets Worker or All.
